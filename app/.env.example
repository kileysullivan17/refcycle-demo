# RefCycle app (port 3001). Copy to .env and fill in; never commit .env.
# The app reads only this folder's .env. Values already set in the environment win over this file.
ENGINE_URL=http://127.0.0.1:3000
# PORT=3001
# HOST=127.0.0.1

# Image model for POST /api/identify (Camera scan). The key stays on the server and never reaches the browser.
LLM_IMAGE_PROVIDER=anthropic
LLM_IMAGE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Demo limits (PRD addendum, ADR 0002). On by default. Read from the server environment only.
# DEMO_LIMITS=off is allowed only on 127.0.0.1 outside production (the scored run and local tests);
# a production start, or a start on any other address, refuses to run with limits off.
# DEMO_LIMITS=on
# DAILY_SPEND_CAP_USD=5
# VISITOR_DAILY_LIMIT=20
# What one question is counted at, in US dollars. The engine reports no token usage, so this is a flat
# amount: about one and a half times the average measured on the scored run of 2026-11-16 (1.75 dollars for
# 90 questions and 30 scans). With the 5 dollar cap that is 166 questions a day. It is an average, not a
# ceiling; a spending limit in the provider's console is the real backstop.
# ASK_COST_USD=0.03
# What is held against the cap while a photo scan runs, in US dollars. The scan is then counted at the
# usage the provider reports; this amount is counted only if the provider reports none.
# SCAN_COST_USD=0.02
# Prices in US dollars per million tokens, used to turn a scan's reported usage into dollars. Defaults are
# Claude Sonnet 5.5 list prices as of 2026-11.
# PRICE_INPUT_USD_PER_MTOK=2
# PRICE_OUTPUT_USD_PER_MTOK=10
# How visitors are told apart behind a host's proxy. Leave both unset when visitors connect to the app
# directly. Set at most one.
# On Fly.io: the app reads the address Fly's proxy writes in Fly-Client-IP. The header is ignored unless
# this is 1. fly.toml sets it on the host.
# TRUST_FLY_CLIENT_IP=1
# Behind a proxy that appends the visitor's address as the last X-Forwarded-For entry (not Fly.io, where
# the last entry is the app's own address).
# TRUST_PROXY=1
